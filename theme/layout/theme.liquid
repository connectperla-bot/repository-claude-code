          cart_add_url: "{{ routes.cart_add_url }}",
          cart_change_url: "{{ routes.cart_change_url }}",
          cart_url: "{{ routes.cart_url }}",
          predictive_search_url: "{{ routes.predictive_search_url }}"
        },
        cart: {
          type: "{{ settings.cart_type }}",
          freeShippingBar: {{ settings.cart_free_shipping_bar | json }},
          freeShippingThreshold: {{ settings.cart_free_shipping_threshold | times: 100 }},
          currency: "{{ cart.currency.iso_code }}"
        },
        moneyFormat: {{ shop.money_format | json }},
        animations: {{ settings.enable_animations | json }},
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          adding: {{ 'products.product.adding' | t | json }},
          added: {{ 'products.product.added' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          freeShippingUnlocked: {{ 'cart.free_shipping.unlocked' | t | json }},
          freeShippingRemaining: {{ 'cart.free_shipping.remaining_html' | t: amount: '[amount]' | json }},
          cartError: {{ 'cart.general.error' | t | json }},
          quizDiscount: "BENVENUTO10",
          discover: {{ 'general.search.discover' | t | json }},
          noResults: {{ 'general.search.no_results' | t | json }},
          noResultsPrefix: {{ 'general.search.no_results_prefix' | t | json }},
          viewAll: {{ 'general.search.view_all' | t | json }},
          searching: {{ 'general.search.searching' | t | json }},
          wishAdded: {{ 'products.product.wishlist_added' | t | json }},
          wishRemoved: {{ 'products.product.wishlist_removed' | t | json }},
          chooseOptions: {{ 'products.product.choose_options' | t | json }},
          notifyMe: {{ 'products.product.notify_me' | t | json }},
          notifySent: {{ 'products.product.notify_sent' | t | json }},
          savedCount: {{ 'customer.saved.count' | t: count: '[count]' | json }},
          composing: {{ 'sections.product.photo_composing' | t | json }},
          composeError: {{ 'sections.product.photo_compose_error' | t | json }},
          mockupPending: {{ 'sections.product.mockup_pending' | t | json }},
          mockupRetry: {{ 'sections.product.mockup_retry' | t | json }}
        },
        features: {
          wishlist: {{ settings.enable_wishlist | default: true | json }},
