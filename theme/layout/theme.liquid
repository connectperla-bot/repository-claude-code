          recentlyViewed: {{ settings.enable_recently_viewed | default: true | json }},
          backInStock: {{ settings.enable_back_in_stock | default: true | json }},
          prefetch: {{ settings.enable_prefetch | default: true | json }}
        },
        shopUrl: "{{ shop.url }}",
        savedPageUrl: {{ pages.salvati.url | default: '/pages/salvati' | json }},
        enablePreloader: {{ settings.enable_preloader | default: true | json }},
        enableParallax: {{ settings.enable_parallax | default: true | json }},
        enableSmoothScroll: {{ settings.enable_smooth_scroll | default: true | json }},
        pearls: {{ settings.enable_pearls | default: true | json }},
        pearlsDensity: {{ settings.pearls_density | default: 'many' | json }},
        spectacle: {{ settings.enable_spectacle | default: true | json }},
        cursorRing: {{ settings.enable_cursor_ring | default: true | json }},
        titleRule: {{ settings.enable_title_rule | default: true | json }},
        blinds: {{ settings.enable_blinds | default: true | json }}
      };
    </script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | handle }}{% if settings.enable_button_sheen %} sheen-on{% endif %}">
    <a class="skip-to-content" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

    {%- comment -%}
      ROUND 24 — l'emblema che gira mentre la pagina carica.

      Va sparito COMUNQUE: un velo rimasto sopra il negozio e' peggio di
      nessun velo. Per questo se ne occupa il CSS con un'animazione che finisce
      da sola dopo 1,8s (vedi perla-type.css §9); il JS qui sotto serve solo ad
      accorciare l'attesa quando la pagina e' gia' pronta prima. Se il JS non
      parte, o parte in ritardo, il velo se ne va lo stesso.

      aria-hidden e inert: un lettore di schermo e la tastiera non ci finiscono
      mai dentro, nemmeno nei millisecondi in cui e' visibile.
    {%- endcomment -%}
    <div class="perla-loader" data-perla-loader aria-hidden="true" inert>
      <img class="perla-loader__mark" src="{{ 'emblem-mark.png' | asset_url }}" alt="" width="72" height="72">
    </div>
    {%- comment -%}
      ROUND 24 — la striscia lunga dell'editor parte dal centro.

      Su collare, ciotola e guinzaglio l'area di stampa e' un nastro (fino a
      56:1): il riquadro dell'editor tiene le proporzioni vere e scorre in
      orizzontale, quindi e' piu' largo della colonna -- 4526px sul guinzaglio.
      Il nome pero' nasce al centro del canvas. Senza questa riga il cliente
      aprirebbe l'editor guardando il primo mezzo metro di guinzaglio vuoto e
      penserebbe che non funziona.

      Sta qui e non nello snippet perche' i riquadri possono essere due (la
      medaglietta ha fronte e retro): una query sola li prende tutti.
    {%- endcomment -%}
    <script>
      (function () {
        function centra() {
          document.querySelectorAll('.fabric-studio__viewport--nastro').forEach(function (v) {
            if (v.scrollWidth > v.clientWidth) v.scrollLeft = (v.scrollWidth - v.clientWidth) / 2;
          });
        }
        if (document.readyState !== 'loading') centra();
        else document.addEventListener('DOMContentLoaded', centra, { once: true });
        window.addEventListener('load', centra, { once: true });
      })();
    </script>
    <script>
      (function () {
        var velo = document.querySelector('[data-perla-loader]');
        if (!velo) return;
        function via() { velo.classList.add('is-out'); }
        if (document.readyState === 'complete') { via(); }
        else { window.addEventListener('load', via, { once: true }); }
        setTimeout(via, 1800);
      })();
    </script>

    {%- if settings.enable_pearls -%}
      <canvas id="perla-pearls" aria-hidden="true"></canvas>
    {%- endif -%}

    {%- if settings.enable_preloader -%}
      <div class="preloader" data-preloader aria-hidden="true">
        <div class="preloader__inner">
          <div class="preloader__emblem">
            {%- if settings.logo != blank -%}
              {{ settings.logo | image_url: width: 168 | image_tag: alt: shop.name, loading: 'eager' }}
            {%- else -%}
              <img src="{{ 'emblem-mark.png' | asset_url }}" alt="{{ shop.name | escape }}" width="84" height="84" loading="eager">
            {%- endif -%}
          </div>
          <div class="preloader__word"><span>{{ shop.name | escape }}</span></div>
          <div class="preloader__bar"><i></i></div>
        </div>
      </div>
    {%- endif -%}

    <div class="read-progress" data-progress aria-hidden="true"><i></i></div>
    <div class="page-fade" aria-hidden="true"></div>

    {% sections 'header-group' %}

    <div class="scroll-wrap" data-scroll-wrap>
      <main id="MainContent" class="main" role="main" tabindex="-1">
        {{ content_for_layout }}
      </main>

      {% sections 'footer-group' %}
    </div>

    {%- # Fullscreen predictive search overlay -%}
    <div class="search-overlay" data-search-overlay role="dialog" aria-modal="true" aria-label="{{ 'general.search.search' | t }}" aria-hidden="true">
      <div class="search-overlay__head">
        <span class="search-overlay__brand">{{ shop.name }}</span>
        <button class="search-overlay__close" type="button" data-search-close aria-label="{{ 'general.search.close' | t | default: 'Close' }}">&times;</button>
      </div>
      <div class="search-overlay__body">
        <form class="search-overlay__field" action="{{ routes.search_url }}" method="get" role="search">
          <input type="search" name="q" class="search-overlay__input" data-search-input placeholder="{{ 'general.search.placeholder' | t | default: 'Cerca…' }}" autocomplete="off">
        </form>
        <p class="search-overlay__hint" data-search-hint></p>
        <div class="search-overlay__results" data-search-results></div>
      </div>
    </div>

    {%- # Fullscreen mobile menu -%}
    <div class="fullmenu" data-fullmenu role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t | default: 'Menu' }}" aria-hidden="true">
      <div class="fullmenu__head">
        <span class="fullmenu__brand">{{ shop.name }}</span>
        <button class="fullmenu__close" type="button" data-fullmenu-close aria-label="{{ 'general.search.close' | t | default: 'Close' }}">&times;</button>
      </div>
      <nav class="fullmenu__nav">
        {%- assign main_menu = linklists['main-menu'] -%}
        {%- for link in main_menu.links -%}
          {%- capture link_hidden -%}{% render 'perla-region-hidden', link_url: link.url %}{%- endcapture -%}
          {%- unless link_hidden contains '1' -%}
            <a class="fullmenu__link" href="{{ link.url }}"><span>{{ link.title }}</span></a>
          {%- endunless -%}
        {%- endfor -%}
        {%- comment -%}
          "Salvati" c'era solo come cuoricino fra le icone in alto, che sul
          telefono e' minuscolo e senza etichetta: chi apre il menu non lo
          trovava. Qui ha un nome, accanto all'account.
        {%- endcomment -%}
        {%- if settings.enable_wishlist -%}
          <a class="fullmenu__link" href="{{ pages.salvati.url | default: '/pages/salvati' }}"><span>{{ 'customer.saved.title' | t | default: 'Salvati' }}</span></a>
        {%- endif -%}
        <a class="fullmenu__link" href="{{ routes.account_url | default: routes.account_login_url }}"><span>{{ 'customer.account.title' | t | default: 'Account' }}</span></a>
        {%- comment -%}
          ROUND 50 — DA TELEFONO NON SI POTEVA SCEGLIERE LA LINGUA.

          Segnalazione: "poi da telefono non si puo scegliere la lingua".
          Il selettore esiste da sempre, ma sta dentro .header__nav--right, e
          base.css a <=749px fa `.header__nav { display:none }`: sul telefono
          sparisce insieme a tutta la barra dei link. Nessun CSS puo'
          rimediarci, perche' un figlio di un elemento display:none non si
          puo' riaccendere.

          Quindi va messo dove chi ha un telefono lo cerca: nel menu. E' la
          stessa scelta gia' fatta per "Salvati" qui sopra, per la stessa
          ragione.

          Il tema lo accende da solo: initAll() passa per initLang(), che
          prende TUTTI i [data-lang-switch] e ne segna uno per uno con
          __langInit. Due selettori nella pagina restano indipendenti e non
          si disturbano; l'unica cosa che non si puo' ripetere e' l'id del
          form, che qui infatti e' LangFormMenu.

          Solo la lingua, come nella barra in alto: il negozio ha un mercato
          solo (browsing_context_suggestions.json risponde con suggestions
          vuoto, Shopify.country = "IT"), quindi non c'e' nessun paese fra
          cui scegliere.
        {%- endcomment -%}
        {%- if localization.available_languages.size > 1 -%}
          <localization-form class="lang-switch lang-switch--menu" data-lang-switch>
            {%- form 'localization', id: 'LangFormMenu', class: 'lang-switch__form' -%}
              <button type="button" class="fullmenu__link lang-switch__current" data-lang-toggle aria-expanded="false">
                <span>{{ 'general.language.dropdown_label' | t | default: 'Lingua' }}</span>
                <span class="lang-switch__code">{{ localization.language.iso_code | upcase }}</span>
              </button>
              <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}" data-lang-input>
              <ul class="lang-switch__list" data-lang-list hidden>
                {%- for lingua in localization.available_languages -%}
                  <li>
                    <button type="button" class="lang-switch__opt{% if lingua.iso_code == localization.language.iso_code %} is-active{% endif %}" data-lang-value="{{ lingua.iso_code }}" lang="{{ lingua.iso_code }}">
                      {{ lingua.endonym_name | capitalize }}
                      <span class="lang-switch__opt-code">{{ lingua.iso_code | upcase }}</span>
                    </button>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </nav>
      <div class="fullmenu__foot">{{ shop.name }} · Italia</div>
    </div>

    {%- if settings.cart_type == 'drawer' -%}
      {% render 'cart-drawer' %}
    {%- endif -%}

    {% render 'newsletter-popup' %}
    {% render 'assistant' %}

    {%- if settings.enable_quick_view -%}
      <div class="qv-modal" data-qv-modal hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'products.product.quick_view' | t }}">
        <div class="qv-modal__overlay" data-qv-close></div>
        <div class="qv-modal__panel" role="document">
          <button type="button" class="qv-modal__close" data-qv-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>
          <div class="qv-modal__body" data-qv-body>
            <div class="qv-modal__loading"><span class="qv-spinner"></span></div>
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%}
      ROUND 12 — modale studio di personalizzazione a schermo intero. Contenitore
      vuoto: assets/global.js (initPhotoStudioFullscreen) sposta qui dentro (via
      appendChild, non fetch/clone) il sottoalbero .photo-studio__panels gia'
      presente e collegato in sections/main-product.liquid, e lo rimette al suo
      posto alla chiusura. Deliberatamente FUORI da .scroll-wrap: lo smooth-scroll
      desktop in assets/motion.js applica un transform a .scroll-wrap, che crea
      un nuovo containing block per gli elementi position:fixed al suo interno —
      esattamente come .qv-modal qui sopra, per lo stesso motivo.
    {%- endcomment -%}
    <div class="pd-modal" data-pd-modal hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'sections.product.photo_studio_title' | t }}">
      <div class="pd-modal__overlay" data-pd-close></div>
      <div class="pd-modal__panel" role="document">
        <div class="pd-modal__head">
          <h2 class="pd-modal__title">{{ 'sections.product.photo_studio_title' | t }}</h2>
          <button type="button" class="pd-modal__close" data-pd-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>
        </div>
        <div class="pd-modal__body" data-pd-body></div>
      </div>
    </div>

    <div class="perla-toasts" data-toasts aria-live="polite" aria-atomic="true"></div>

    {%- if template.name == 'product' and product -%}
      <script type="application/json" data-rv-current>{{ product.handle | json }}</script>
    {%- endif -%}

    {%- comment -%}
      ROUND 25 -- Fabric.js non e' piu' un <script defer> statico qui: essendo
      elencato prima di global.js, il browser deve finire di eseguirlo (defer
      mantiene l'ordine documento) prima di eseguire global.js, quindi TUTTO il
      resto del sito (header, carrello, galleria, quiz, ecc.) su ogni pagina
      prodotto personalizzabile aspettava inutilmente il parsing di 306KB di
      libreria solo per l'editor foto. Ora e' assets/global.js
      (loadFabric/initPhotoCustomizer) che lo inietta via JS appena parte,
      cosi' il resto del file esegue subito e l'editor si avvia comunque non
      appena la libreria arriva.
    {%- endcomment -%}

    <script src="{{ 'global.js' | asset_url }}" defer></script>
    {%- comment -%}
      ROUND 33 — miglioramenti dell'editor che NON entrano in global.js:
      trascina-e-rilascia, stato vuoto, anteprima del nome che segue il font
      scelto, stati di caricamento/errore sull'anteprima reale, invito a
      ruotare il telefono sui prodotti a striscia. File separato e caricato
      DOPO global.js, si aggancia solo agli hook data-* gia' esistenti —
      nessuna riga di global.js e' stata toccata, quindi il percorso che porta
      il file alla stampa resta identico.
    {%- endcomment -%}
    <script src="{{ 'perla-studio-ui.js' | asset_url }}" defer></script>
    <script src="{{ 'motion.js' | asset_url }}" defer></script>
    {%- if settings.enable_pearls -%}<script src="{{ 'pearls.js' | asset_url }}" defer></script>{%- endif -%}
    <script>document.addEventListener('DOMContentLoaded',function(){window.PerlaMotionInit&&window.PerlaMotionInit();window.PerlaPearlsInit&&window.PerlaPearlsInit();});</script>

    {%- comment -%}
      ROUND 49 -- prima si chiede, poi si misura, e in quest'ordine.
      Il banner del consenso: fino a ieri non c'era proprio, e siccome
      perla-analytics tiene tutto dietro analyticsProcessingAllowed(), nessuno
      poteva dire di si' e la misurazione era zero per costruzione. I due
      snippet non si parlano direttamente: perla-cookie chiama
      setTrackingConsent, Shopify emette visitorConsentCollected, e
      perla-analytics -- che quell'evento lo ascolta gia' -- parte da solo,
      senza ricaricare la pagina.
    {%- endcomment -%}
    {% render 'perla-cookie' %}

    {%- comment -%}
      Clarity, Google Analytics e il pixel di Meta: tutti e tre col consenso,
      tutti e tre spenti finche' il relativo ID non e' compilato in
      Impostazioni tema -> Marketing e Analytics.
    {%- endcomment -%}
    {% render 'perla-analytics' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
    </ul>
  </body>
</html>
