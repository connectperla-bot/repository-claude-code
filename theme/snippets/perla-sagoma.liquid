{%- if fin_sx > 0 or fin_alto > 0 or fin_dx < 100 or fin_basso < 100 -%}
  <div class="fabric-studio__finestra" aria-hidden="true">
    <span class="fabric-studio__fuori fabric-studio__fuori--alto" style="height: {{ fin_alto }}%;"></span>
    <span class="fabric-studio__fuori fabric-studio__fuori--basso" style="top: {{ fin_basso }}%;"></span>
    <span class="fabric-studio__fuori fabric-studio__fuori--sx" style="top: {{ fin_alto }}%; height: {{ fin_basso | minus: fin_alto }}%; width: {{ fin_sx }}%;"></span>
    <span class="fabric-studio__fuori fabric-studio__fuori--dx" style="top: {{ fin_alto }}%; height: {{ fin_basso | minus: fin_alto }}%; left: {{ fin_dx }}%;"></span>
    <span class="fabric-studio__finestra-bordo" style="left: {{ fin_sx }}%; top: {{ fin_alto }}%; width: {{ fin_dx | minus: fin_sx }}%; height: {{ fin_basso | minus: fin_alto }}%;"></span>
  </div>
{%- endif -%}
