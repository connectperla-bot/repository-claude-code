# Segreti - MAI committare
config/printify.local.env
config/*.local.env
.env
.env.*

# Dipendenze
node_modules/
scripts/node_modules/
__pycache__/

# Stato locale claude-flow / tool interni, non serve nel repo di deploy
.claude-flow/
.hive-mind/
.swarm/
ruvector.db
task.txt

# OS
Thumbs.db
.DS_Store

# database locale delle skill: stato di questa macchina, non del progetto
.claude/memory.db

# Area di transito di scripts/perla-eu-foto-mockup.py: i JPG vivono il tempo di
# essere appiattiti su bianco e caricati. Le copie che contano stanno su
# Cloudinary (URL permanenti) e su Shopify; qui resterebbero 8 MB di duplicati.
out-foto/

# Il foglio dei margini e i suoi dati grezzi: una fotografia dei costi in un
# dato momento, che si rifa' con due comandi (stanno in cima a
# scripts/perla-foglio-margini.py). In git ci va lo script, non il foglio --
# se no fra un mese ci sono dodici versioni e nessuno sa quale vale.
out-listino/

# Banco di prova: le sonde mandate ai fornitori per misurare un'area di stampa
# (scacchiere numerate, tinte piatte) e i mockup che tornano indietro. Sono
# pixel usa-e-getta -- il metodo per rifarli sta scritto per esteso in
# snippets/perla-forme-varianti.liquid, e i numeri che se ne ricavano
# (finestra, sagome) finiscono nel tema, che e' la copia che conta.
scratchpad/

# Area di transito di scripts/perla-eu-foto-col-nome.py: stesso ragionamento di
# out-foto/. Le due foto che contano (collare e guinzaglio "Crea il Tuo Design"
# col nome Luna) sono gia' su Cloudinary e agganciate a Shopify.
out-foto-nome/

# Uscita di scripts/perla-file-stampa-motivi.py: ~290 MB fra originali
# scaricati da Cloudinary e ritagli a piena risoluzione. Tutto rigenerabile con
# un comando, e gli URL degli originali sono gia' versionati in
# scripts/perla-eu-prodotti.json. In git ci va lo script, non la sua uscita.
generated-designs/motivi-stampa/

# Anteprima di scripts/perla-motivi-nuovi.py eseguito a mano: e' un provino
# per guardare i motivi, si rifa' con `python3 scripts/perla-motivi-nuovi.py`.
motivi/
generated-designs/usa-print-files/

# Uscita di scripts/perla-verifica-prodotti.py: e' una fotografia dello stato
# dei prodotti in un dato momento, si rifa' con un comando. In git ci va lo
# script, non il suo referto.
generated-designs/audit-prodotti.json
generated-designs/audit-mockup/

# Uscita di scripts/perla-eu-mockup.py: mockup rigenerabili con un comando.
generated-designs/eu-mockup/

# Fotografia dei titoli di taglia su Shopify, per l'audit --eu. Va rifatta
# quando i prodotti cambiano: la query sta in perla-verifica-prodotti.py.
generated-designs/taglie-eu.json

# Motivi EU corretti: 160 MB di file di stampa, si ricostruiscono con
# scripts/perla-eu-motivi-corretti.py --costruisci --tutti. In git ci va lo
# script, non i pixel.
generated-designs/eu-motivi-corretti/

# Cache di scripts/perla-dettaglio-stampa.py: i file di stampa scaricati e le
# foto del tessuto che ne escono. Le copie che contano stanno su Cloudinary e
# su Shopify; qui sarebbero 70 immagini rigenerabili in un comando.
generated-designs/dettagli-stampa/
generated-designs/dettaglio-da-attaccare.json

# Fotografia di Shopify per l'audit --editor (tag, metafield, tabella dei tipi
# dal tema pubblicato) e l'elenco delle scritture che ne discende. Come
# taglie-eu.json: si rifanno quando i prodotti cambiano.
generated-designs/editor-shopify.json
generated-designs/editor-da-scrivere.json
generated-designs/foto-eu-da-attaccare.json
# Stessa natura: l'elenco dei prezzi da scrivere che esce da
# perla-prezzi-margine.py --scrivi. Si rifa' in un comando, e i prezzi
# che contano stanno su Shopify.
generated-designs/prezzi-da-scrivere.json
# File di stampa rigenerati da perla-rifai-motivi.py: 217 MB, e si
# ricostruiscono in sei minuti dal codice che li disegna. Nel repository sta
# la ricetta, non la torta.
generated-designs/motivi-rifatti/

# Stesso principio, due cartelle che erano sfuggite: 387 MB in tutto, in ogni
# clone, e un diff binario enorme a ogni rigenerazione.
#   stampe-scaricate/  le stampe che perla-verifica-prodotti.py scarica per
#                      controllarle: sono una COPIA di quello che sta sui
#                      fornitori, 331 MB, e si riscaricano quando servono.
#   tappetini/         i file di stampa dei tappetini, 56 MB, disegnati da
#                      perla-tappetini-motivi.py e gia' caricati su Printify.
generated-designs/stampe-scaricate/
generated-designs/tappetini/

# Lo stato di questa macchina, non del progetto. La regola c'era gia' ma il
# file era stato aggiunto PRIMA che esistesse, e .gitignore non ha effetto su
# cio' che e' gia' in indice: andava scollegato a mano.
.claude/memory.db
# ...e l'anteprima a contatto dei motivi ornati. La riga diceva
# "scripts/anteprima-motivi-ornati.png", ma perla-motivi-ornati.py la
# scrive nella RADICE: la regola mancava il bersaglio di una cartella, e
# quel PNG da 1,8 MB e' finito tracciato.
anteprima-motivi-ornati.png
