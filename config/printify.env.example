# Copia questo file in printify.local.env e inserisci le tue credenziali reali.
# NON versionare / NON condividere printify.local.env.
# NON inserire mai queste chiavi nel file .bat.

SHOPIFY_WEBHOOK_SECRET=
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=

# Printful (collare_eu/bandana_eu/ciotola_eu/guinzaglio_eu, prodotti NUOVI e
# distinti dai corrispondenti Printify - vedi scripts/provider-router.js).
# Usate anche da perla-upload-endpoint.js per /generate-mockup su questi 4
# tipi (vedi PRINTFUL_MOCKUP_CONFIG li' dentro). Lascia tutto vuoto finche' i
# prodotti _eu non sono pronti: senza PRINTFUL_API_KEY il router ordini usa
# sempre Printify, nessun ordine si rompe (ma /generate-mockup sui tipi _eu
# restituira' errore finche' non imposti anche queste).
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=
PRINTFUL_COLLARE_EU_VARIANT_ID=
PRINTFUL_BANDANA_EU_VARIANT_ID=
PRINTFUL_CIOTOLA_EU_VARIANT_ID=
PRINTFUL_GUINZAGLIO_EU_VARIANT_ID=

# Contrado (linea premium: cuccia_lux/guinzaglio_lux/bandana_lux/ciotola_lux,
# vedi scripts/provider-router.js). API "Helix", autenticazione a header
# X-API-KEY, limite 100 richieste al minuto.
#
# Il token si genera in Contrado Store Account -> API Integration. Va copiato
# subito: non e' piu' visualizzabile dopo la creazione. Servono gli scope
# StoresRead, StoreProductsRead, StoreOrdersRead e StoreOrdersWrite.
#
# CONTRADO_STORE_ID serve SOLO se il token e' di tipo "Account" (accede a piu'
# negozi): diventa l'header X-Store-Id. Con un token di tipo "Store" lascialo
# vuoto.
#
# ATTENZIONE, limite dell'API: gli ordini Contrado si creano indicando un
# prodotto che esiste GIA' nel negozio Contrado (storeProductId + variantId).
# Non esiste nessun campo per allegare un file di stampa o la personalizzazione
# del cliente. I design vanno quindi caricati e trasformati in prodotti dentro
# Contrado Store Account, non da qui. Vedi scripts/providers/contrado-client.js.
CONTRADO_API_KEY=
CONTRADO_STORE_ID=
# Codice cultura usato per prezzi e spedizioni (it-IT, en-GB, de-DE, fr-FR,
# es-ES, nl-NL, sv-SE, en-US, en-IE, en-AU, en-CA, en-NZ, ja-JP).
CONTRADO_CULTURE_CODE=it-IT
# storeProductId del prodotto Contrado corrispondente a ogni tipo Shopify.
# Li leggi con: node scripts/contrado-catalog.js --prodotti
CONTRADO_CUCCIA_LUX_PRODUCT_ID=
CONTRADO_GUINZAGLIO_LUX_PRODUCT_ID=
CONTRADO_BANDANA_LUX_PRODUCT_ID=
CONTRADO_CIOTOLA_LUX_PRODUCT_ID=
CONTRADO_TAPPETINO_LUX_PRODUCT_ID=
CONTRADO_COPERTA_LUX_PRODUCT_ID=

# Mappatura per tipo di prodotto (studio di personalizzazione).
# blueprint/provider sono gia' compilati con i dati reali del catalogo Printify.
# *_VARIANT_ID va scelto da te in base a taglia/colore che vendi davvero:
# GET https://api.printify.com/v1/catalog/blueprints/<blueprint>/print_providers/<provider>/variants.json
COLLARE_BLUEPRINT_ID=784
COLLARE_PROVIDER_ID=93
COLLARE_VARIANT_ID=

BANDANA_BLUEPRINT_ID=562
BANDANA_PROVIDER_ID=70
BANDANA_VARIANT_ID=

MEDAGLIETTA_BLUEPRINT_ID=566
MEDAGLIETTA_PROVIDER_ID=70
MEDAGLIETTA_VARIANT_ID=

CIOTOLA_BLUEPRINT_ID=570
CIOTOLA_PROVIDER_ID=70
CIOTOLA_VARIANT_ID=

CUCCIA_BLUEPRINT_ID=419
CUCCIA_PROVIDER_ID=10
CUCCIA_VARIANT_ID=

TAPPETINO_BLUEPRINT_ID=855
TAPPETINO_PROVIDER_ID=70
TAPPETINO_VARIANT_ID=

GUINZAGLIO_BLUEPRINT_ID=2791
GUINZAGLIO_PROVIDER_ID=80
GUINZAGLIO_VARIANT_ID=

# Assistente AI (scripts/perla-assistant-bot.js) - chiave gratuita su https://aistudio.google.com/apikey
GEMINI_API_KEY=
ALLOWED_ORIGIN=*

PORT=3000
MAX_UPLOAD_MB=10
