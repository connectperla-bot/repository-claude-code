# Copia questo file in printify.local.env e inserisci le tue credenziali reali.
# NON versionare / NON condividere printify.local.env.
# NON inserire mai queste chiavi nel file .bat.

SHOPIFY_WEBHOOK_SECRET=
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=

# Printful (collare_eu/bandana_eu/ciotola_eu/guinzaglio_eu, prodotti NUOVI e
# distinti dai corrispondenti Printify - vedi scripts/provider-router.js).
# Usate anche da perla-upload-endpoint.js per /generate-mockup su questi 4
# tipi (vedi PRINTFUL_MOCKUP_CONFIG li' dentro). Lascia tutto vuoto finche' i
# prodotti _eu non sono pronti: senza PRINTFUL_API_KEY il router ordini usa
# sempre Printify, nessun ordine si rompe (ma /generate-mockup sui tipi _eu
# restituira' errore finche' non imposti anche queste).
#
# VANNO SU DUE SERVIZI DIVERSI, ED E' L'ERRORE FACILE DA FARE.
# perla-upload-endpoint le usa per le anteprime, perla-printify-order-sync per
# gli ordini veri: sono due servizi Render separati, con due elenchi di
# variabili separati. Metterle solo sul primo fa funzionare le anteprime e
# rompe la produzione, e non se ne accorge nessuno finche' non arriva un
# ordine -- cioe' nel momento peggiore.
#
# COME SI CONTROLLA DA FUORI, SENZA ORDINARE NIENTE
# Si chiede un'anteprima con un id immagine finto e si legge QUALE errore
# torna: i controlli di configurazione vengono prima di tutto il resto.
#
#   curl -s -X POST https://<servizio>.onrender.com/generate-mockup \
#     -H 'Content-Type: application/json' \
#     -d '{"product_type":"COLLARE_EU","composite_image_id":"000000000000000000000000"}'
#
#   "PRINTFUL_API_KEY/PRINTFUL_STORE_ID non configurati"  -> manca la chiave
#   "Variante Printful non configurata per questo tipo"   -> manca la variante
#   "Impossibile generare l'anteprima da Printful"        -> configurazione OK,
#       si e' fermato sull'immagine finta, che e' quello che deve succedere
#
# I PRODOTTI SU PRINTFUL NON DEVONO ESISTERE.
# Gli ordini vanno al CATALOGO Printful (variant_id + file di stampa di quel
# cliente, vedi providers/printful-client.js), non ai prodotti dello store.
# "I miei prodotti" su Printful resta vuoto per sempre, ed e' giusto cosi':
# un prodotto Printful e' un modello fisso, e i nostri portano il nome del
# cane di chi compra.
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=
PRINTFUL_COLLARE_EU_VARIANT_ID=
PRINTFUL_BANDANA_EU_VARIANT_ID=
PRINTFUL_CIOTOLA_EU_VARIANT_ID=
PRINTFUL_GUINZAGLIO_EU_VARIANT_ID=

# Mappatura per tipo di prodotto (studio di personalizzazione).
# blueprint/provider sono gia' compilati con i dati reali del catalogo Printify.
# *_VARIANT_ID va scelto da te in base a taglia/colore che vendi davvero:
# GET https://api.printify.com/v1/catalog/blueprints/<blueprint>/print_providers/<provider>/variants.json
COLLARE_BLUEPRINT_ID=784
COLLARE_PROVIDER_ID=93
COLLARE_VARIANT_ID=

BANDANA_BLUEPRINT_ID=562
BANDANA_PROVIDER_ID=70
BANDANA_VARIANT_ID=

MEDAGLIETTA_BLUEPRINT_ID=566
MEDAGLIETTA_PROVIDER_ID=70
MEDAGLIETTA_VARIANT_ID=

CIOTOLA_BLUEPRINT_ID=570
CIOTOLA_PROVIDER_ID=70
CIOTOLA_VARIANT_ID=

CUCCIA_BLUEPRINT_ID=419
CUCCIA_PROVIDER_ID=10
CUCCIA_VARIANT_ID=

# ROUND 59 -- il TAPPETINO ha cambiato fornitore prima ancora di nascere.
# Era 855/70 (Printed Mint), scelto sulla carta: area di stampa 1,44 e
# spedizione in Italia che si mangiava tutto il margine. E' 623/10 (MWW On
# Demand), dove l'Italia sta nella fascia europea a 7,79 dollari -- la piu'
# bassa di tutto il catalogo Printify. Consegna 10-30 giorni: la fascia di
# prezzo e' europea, quella di consegna no, ed e' scritto cosi' anche nella
# scheda prodotto.
#
# Tre varianti, DUE sagome e DUE misure:
#   73844 osso   19x14 pollici  area 3150x2400
#   73845 osso   30x18 pollici  area 4800x3000
#   73846 pesce  19x14 pollici  area 3150x2400
# VARIANT_ID e' solo il ripiego: con tre varianti la scelta vera la fa
# scripts/varianti-fornitore.js dal titolo pagato dal cliente.
#
# Il GUINZAGLIO Printify invece non ha ancora nessun prodotto (il guinzaglio
# EU e' un'altra cosa, lo fa Printful, vedi PRINTFUL_GUINZAGLIO_EU_VARIANT_ID
# qui sopra).
TAPPETINO_BLUEPRINT_ID=623
TAPPETINO_PROVIDER_ID=10
TAPPETINO_VARIANT_ID=

GUINZAGLIO_BLUEPRINT_ID=2791
GUINZAGLIO_PROVIDER_ID=80
GUINZAGLIO_VARIANT_ID=

# ROUND 55 -- i tre americani nuovi: collare in pelle inciso, medaglietta
# incisa, giacchetto parka. Qui le tre righe sono COMPLETE, *_VARIANT_ID
# compreso, e va spiegato perche', visto che sopra sono tutte vuote.
#
# Per l'ORDINE il variante non serve: questi tre stanno in
# scripts/varianti-fornitore.js, quindi l'id lo decide la taglia che il
# cliente ha scelto e pagato (ROUND 42). Serve invece per l'ANTEPRIMA:
# perla-upload-endpoint.js crea un prodotto temporaneo su Printify per farsi
# generare il mockup, e un prodotto vuole una variante. Senza queste tre
# righe "Salva anteprima" risponde "Configurazione mancante".
#
# I valori sono la prima variante di ciascun blueprint (Small/Black/Silver,
# Circle/Black/One size, XS/Khaki): quale sia non cambia niente, l'anteprima
# usa il prodotto temporaneo e lo cancella.
COLLARE_PELLE_BLUEPRINT_ID=10700
COLLARE_PELLE_PROVIDER_ID=217
COLLARE_PELLE_VARIANT_ID=397097

MEDAGLIETTA_INCISA_BLUEPRINT_ID=10674
MEDAGLIETTA_INCISA_PROVIDER_ID=228
MEDAGLIETTA_INCISA_VARIANT_ID=397011

GIACCHETTO_BLUEPRINT_ID=10740
GIACCHETTO_PROVIDER_ID=72
GIACCHETTO_VARIANT_ID=399940

# Assistente AI (scripts/perla-assistant-bot.js) - chiave gratuita su https://aistudio.google.com/apikey
GEMINI_API_KEY=
ALLOWED_ORIGIN=*

PORT=3000
MAX_UPLOAD_MB=1


# ROUND 45 -- qui c'era una chiave Contrado VERA, in un file versionato e
# pubblico. L'integrazione Contrado era gia' stata rimossa (commit 5952a92)
# ma la chiave era rimasta. Va REVOCATA dal pannello Contrado: toglierla da
# qui non la cancella dalla cronologia git.
CONTRADO_API_KEY=



# ROUND 47 -- NON PIU' OPZIONALI. Servono per due cose, e la seconda e' quella
# che il cliente vede.
#
#   1. Un'evasione fallita mette un tag "evasione-fallita" e una nota
#      sull'ordine Shopify, invece di restare solo nei log di Render.
#   2. Quando lo stampatore spedisce, la spedizione viene scritta su Shopify e
#      Shopify manda al cliente l'email col numero di tracciamento
#      (scripts/evasione-shopify.js). Senza queste due variabili il cliente
#      paga, riceve il pacco, e non ha mai saputo che era partito -- mentre la
#      pagina Spedizioni del negozio gli promette il contrario.
#
# Permessi necessari sull'app personalizzata:
#   write_orders
#   read_orders
#   write_merchant_managed_fulfillment_orders
#   read_merchant_managed_fulfillment_orders
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_SHOP_DOMAIN=


# ROUND 47 -- i webhook della SPEDIZIONE, cioe' il verso opposto degli ordini.
# Vanno sul servizio perla-printify-order-sync (non su quello degli upload).
#
# PRINTFUL non firma le sue chiamate: la loro documentazione dice di usare un
# indirizzo segreto. Scegli una stringa lunga a caso, mettila qui, e registra
# su Printful (Impostazioni > Webhook > "Package shipped") l'indirizzo:
#     https://<servizio>.onrender.com/webhooks/printful/<questa-stringa>
# Chi non la indovina riceve 404 e basta. Trattala come una password.
PRINTFUL_WEBHOOK_PATH=
#
# PRINTIFY firma davvero, con X-Pfy-Signature. Registra il webhook
# "order:shipment:created" su
#     https://<servizio>.onrender.com/webhooks/printify/shipment
# e incolla qui il secret che ti mostrano.
PRINTIFY_WEBHOOK_SECRET=
